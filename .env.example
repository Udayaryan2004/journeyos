# ============================================================================
# JourneyOS — copy this file to .env.local and fill in the blanks.
# .env.local is gitignored and must never be committed.
# ============================================================================

# ---------------------------------------------------------------------------
# Database — PostgreSQL 17 in Docker on port 5433
#   docker run -d --name journeyos-db \
#     -e POSTGRES_DB=journeyos -e POSTGRES_USER=journeyos -e POSTGRES_PASSWORD=journeyos \
#     -p 5433:5432 -v journeyos-pgdata:/var/lib/postgresql/data postgres:17
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://journeyos:journeyos@localhost:5433/journeyos

# ---------------------------------------------------------------------------
# Auth — generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_TTL=900

# ---------------------------------------------------------------------------
# AI — OpenAI.
# Leave OPENAI_API_KEY empty and the app runs on a deterministic fallback
# planner: every feature still works end to end, it just doesn't reason.
# Paste a key and the real model takes over with no code change.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
MODEL_PLANNER=gpt-4o
MODEL_EXTRACTOR=gpt-4o-mini
AI_DAILY_CAP_USD=10
AI_MAX_TOOL_ITERATIONS=6

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
