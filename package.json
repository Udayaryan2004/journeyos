{
  "name": "journeyos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker start journeyos-db",
    "db:reset": "docker exec -i journeyos-db psql -U journeyos -d journeyos -v ON_ERROR_STOP=1 -f /tmp/schema.sql",
    "db:load": "docker cp schema.sql journeyos-db:/tmp/schema.sql && npm run db:reset",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "openai": "^7.27.0",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "JourneyOS - Your AI Travel Operating System"
}
